with cte as (
    select requester_id as 'id', (select count(*) from requestaccepted 
    where id = requester_id or id = accepter_id) as 'num' from requestaccepted
union all
select accepter_id as 'id', (select count(*) from requestaccepted 
where id = requester_id or id = accepter_id) as 'num' from requestaccepted )
select * from cte order by num desc limit 1;